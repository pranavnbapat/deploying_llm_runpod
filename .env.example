# Operator secrets passed to setup.sh on the pod.
#
# Copy this file to .env (it's gitignored) and fill in what you have:
#
#   cp .env.example .env
#   nano .env
#   ./setup.sh
#
# setup.sh reads this file and exports KEY=value pairs for variables that are
# not already set in the shell. Shell environment wins, so one-off overrides
# can be passed as `MODEL=... ./setup.sh` or `export HF_TOKEN=...`.

# HuggingFace read-only token.
# Anonymous downloads are rate-limited to ~10 MB/s; with a token you get the
# full CDN. A 17 GB model takes ~3 min with a token vs. ~30 min without.
# Generate at: https://huggingface.co/settings/tokens
HF_TOKEN=

# Pre-set vLLM Bearer API key. Leave empty to have setup.sh auto-generate
# a 32-byte hex key. Set this if you want a specific key (e.g. matching an
# existing client config).
VLLM_API_KEY=

# vLLM model to serve. Leave empty to use the default baked into
# files/envs/vllm.env.example (stelterlab/Qwen3-30B-A3B-Instruct-2507-AWQ).
# Only applied when /workspace/envs/vllm.env is first created. On an existing
# pod, switch live with: ./switch_model.sh <model-id> [max-len]
MODEL=

# Max context length for the model above. Leave empty for the vllm.env
# default (32768).
MAX_LEN=

# Max concurrent sequences vLLM batches on the GPU (in-flight requests).
# Rule of thumb: MAX_NUM_SEQS × MAX_LEN must fit the KV-cache VRAM left after
# model weights. Leave empty for the vllm.env default (1 = serialize requests).
# NOTE: Traefik's vllm-inflight cap (traefik/dynamic/vllm.yml) also gates
# concurrency at the proxy and must be raised separately — not driven by .env.
MAX_NUM_SEQS=
