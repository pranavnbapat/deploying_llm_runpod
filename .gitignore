# ============================================================
# Sensitive / pod-generated files — NEVER commit
# ============================================================
# Real env files are created on the pod from the .example versions.
files/envs/vllm.env
files/envs/control_plane.env
files/envs/*.env
!files/envs/*.env.example

# Generated by setup.sh — contains bcrypt hashes
files/traefik/users.htpasswd

# User-curated registry on the pod (commit the .example, not the live file)
files/ops/models.yaml
!files/ops/models.yaml.example

# Any local-only Traefik dynamic configs
files/traefik/dynamic/*.local.yml

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.Python

# Virtual environments
.venv/
venv/
env/

# ============================================================
# IDE / editor
# ============================================================
.idea/
.vscode/
*.swp
*.swo
*~

# ============================================================
# OS junk
# ============================================================
.DS_Store
Thumbs.db

# ============================================================
# Runtime artefacts (don't normally appear here, but defensive)
# ============================================================
*.log
logs/
*.pid
*.sock

# ============================================================
# Model weights / caches (in case anyone accidentally drops one here)
# ============================================================
*.safetensors
*.bin
*.gguf
*.pt
*.pth
*.ckpt
hf_cache/
.cache/
