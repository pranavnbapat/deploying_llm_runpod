# Registry of models the control plane offers in /admin/models/available
# and in the /admin/models/switch dropdown (Swagger UI).
#
# extra_args is appended verbatim to `vllm serve` (i.e. VLLM_EXTRA_ARGS).
#
# IMPORTANT: edits here only affect the dropdown after a control_plane restart:
#   supervisorctl restart control_plane
# (the registry is read live for /models/available, but the OpenAPI schema
# is fixed at app startup.)

models:
  - id: stelterlab/Qwen3-30B-A3B-Instruct-2507-AWQ
    label: Qwen3 30B-A3B Instruct (AWQ)
    max_len: 32768
    extra_args: "--quantization awq"
    notes: "MoE 30B total / 3B active, AWQ-quantised, ~17–20 GB VRAM."
