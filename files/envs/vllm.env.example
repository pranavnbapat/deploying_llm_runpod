# vLLM model to serve. Change with ./switch_model.sh <model-id> [max-len]
MODEL=stelterlab/Qwen3-30B-A3B-Instruct-2507-AWQ

# Stable alias clients use in OpenAI-API requests regardless of which MODEL is loaded.
# i.e. always send "model": "current" — no client change when you switch models.
SERVED_MODEL_NAME=current

# Bearer token required on /v1/* requests. Generate with: openssl rand -hex 32
VLLM_API_KEY=CHANGE_ME

# Internal port. Traefik proxies public :8000 -> this. Don't expose this in Runpod.
# 18001 (not 8001!) — Runpod's nginx grabs 8001/8081/7861/9091/3001/7270 on most
# templates, which blocks any other process from binding those ports.
VLLM_PORT=18001

# GPU + context tuning.
GPU_UTIL=0.90
MAX_LEN=32768
MAX_NUM_SEQS=1

# Anything you want appended to `vllm serve` verbatim
# (e.g. --dtype bfloat16 --trust-remote-code).
# MUST be quoted if it contains spaces — this file is sourced by bash.
# Empty by default: vLLM auto-detects quantization from the model's config.json.
# Only override if the model needs a hint vLLM can't infer.
VLLM_EXTRA_ARGS=""
