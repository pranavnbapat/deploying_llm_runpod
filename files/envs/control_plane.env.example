# Internal URL the control plane uses to probe vLLM.
VLLM_INTERNAL_URL=http://127.0.0.1:8001

# Port the control plane binds to. Loopback only — never exposed publicly.
# Auth for /admin/* is enforced at Traefik via basicAuth (see
# /workspace/traefik/users.htpasswd and traefik/dynamic/control_plane.yml).
CONTROL_PLANE_PORT=8002

# External path prefix Traefik mounts this app at. Must match the stripPrefix
# in traefik/dynamic/control_plane.yml. Lets Swagger UI emit correct URLs.
CONTROL_PLANE_ROOT_PATH=/admin
